# Visora Environment Configuration

# Base URL of the Unity Editor HTTP bridge (AnkleBreaker)
UNITY_BRIDGE_URL=http://localhost

# Ports to try. Bridge will try UNITY_BRIDGE_PORT first, then fallback to UNITY_BRIDGE_FALLBACK_PORT
UNITY_BRIDGE_PORT=7890
UNITY_BRIDGE_FALLBACK_PORT=7891
UNITY_BRIDGE_TIMEOUT_SECONDS=10
UNITY_BRIDGE_PING_TIMEOUT_SECONDS=2

# Logging configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
