# Visora Environment Configuration

# Base URL of the Unity Editor HTTP bridge
UNITY_BRIDGE_URL=http://127.0.0.1

# Ports to try. Bridge will try UNITY_BRIDGE_PORT first, then fallback to UNITY_BRIDGE_FALLBACK_PORT
UNITY_BRIDGE_PORT=7890
UNITY_BRIDGE_FALLBACK_PORT=7891
# Additional ports scanned after the two above, in order, comma-separated
UNITY_BRIDGE_PORTS_TO_SCAN=7890,7891,7892,7893
UNITY_BRIDGE_TIMEOUT_SECONDS=10
UNITY_BRIDGE_PING_TIMEOUT_SECONDS=2
UNITY_BRIDGE_EXECUTION_TIMEOUT_SECONDS=60
UNITY_BRIDGE_MAX_RETRIES=2
UNITY_BRIDGE_RETRY_BACKOFF=0.5

# Transport selection: legacy (default), native, or auto (prefers legacy)
UNITY_BRIDGE_MODE=legacy

# Logging configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Asset search & download (backend/tools/asset) ---

# Sketchfab: https://help.sketchfab.com/hc/en-us/articles/202600683-Finding-your-API-Token
# Free account is enough. Required to resolve/download Sketchfab models. Search works without it
# too, but (verified live, even with a valid token) the public search endpoint ignores the query
# text entirely - use the web_search_assets tool as a workaround for finding specific models.
SKETCHFAB_API_TOKEN=your_sketchfab_api_token_here

# Poly Pizza: https://poly.pizza/ -> account -> API key. Required for Poly Pizza search/download.
POLY_PIZZA_API_KEY=your_poly_pizza_api_key_here

# Default Assets/-relative folder new downloads are placed into
DEFAULT_ASSET_IMPORT_DIR=Assets/VisoraDownloads

# Network + archive safety limits for downloaded assets
ASSET_DOWNLOAD_TIMEOUT_SECONDS=120
MAX_ASSET_DOWNLOAD_SIZE_BYTES=250000000
ASSET_CACHE_DIR=.visora_cache
MAX_ASSET_ARCHIVE_ENTRIES=10000
MAX_ASSET_ARCHIVE_UNCOMPRESSED_SIZE_BYTES=1000000000
MAX_ASSET_ARCHIVE_ENTRY_SIZE_BYTES=250000000
MAX_ASSET_ARCHIVE_COMPRESSION_RATIO=100

# web_search_assets tool: finds real Sketchfab model pages via web search, since Sketchfab's own
# search API can't. No API key needed for either. Comma-separated, tried in order; falls back
# further to scraping DuckDuckGo if every instance here fails.
# Verified live: public SearXNG instances commonly refuse or rate-limit the JSON API for anonymous
# callers (their own recommended anti-abuse posture) - the DuckDuckGo fallback is what actually
# carries most real queries with the defaults below. For a reliable primary path, point this at a
# self-hosted SearXNG instance instead (https://docs.searxng.org/admin/installation.html).
SEARXNG_INSTANCE_URLS=https://searx.be,https://searx.tiekoetter.com,https://priv.au
WEB_SEARCH_TIMEOUT_SECONDS=10
